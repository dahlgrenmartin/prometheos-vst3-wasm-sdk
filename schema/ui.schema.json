{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheos.dev/schema/webvst/ui-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "theme": {
      "type": "object",
      "propertyNames": {
        "maxLength": 128
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "number"
          }
        ]
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "row",
            "column",
            "grid",
            "label",
            "button",
            "toggle",
            "slider",
            "knob",
            "combo",
            "group",
            "slot",
            "image"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parameter": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})$"
        },
        "children": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "asset": {
          "type": "string",
          "maxLength": 128
        },
        "choices": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "width": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0?\\.[0-9]*[1-9][0-9]*)fr$",
              "maxLength": 32
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0?\\.[0-9]*[1-9][0-9]*)fr$",
              "maxLength": 32
            }
          ]
        },
        "minWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "minHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "flex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "breakpoints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maxWidth"
            ],
            "properties": {
              "maxWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "button",
                  "toggle",
                  "slider",
                  "knob",
                  "combo",
                  "slot"
                ]
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ]
          }
        }
      ]
    }
  }
}
